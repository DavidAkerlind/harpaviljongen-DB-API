PORT=7000
# Use a separate database locally, e.g. mongodb://127.0.0.1:27017/harpaviljongen-dev
# or your Atlas cluster with a different database name (…mongodb.net/harpaviljongen-dev)
CONNECTION_STRING=

# Long random string used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login lasts (e.g. 12h, 7d)
JWT_EXPIRES_IN=12h

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder for menu PDFs. Use menu-pdfs-dev locally so tests never mix with production.
CLOUDINARY_FOLDER=menu-pdfs
# Folder for profile pictures. Use admin-avatars-dev locally.
CLOUDINARY_AVATAR_FOLDER=admin-avatars
