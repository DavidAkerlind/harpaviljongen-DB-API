PORT=7000
# Use a separate database locally, e.g. mongodb://127.0.0.1:27017/harpaviljongen-dev
# or your Atlas cluster with a different database name (…mongodb.net/harpaviljongen-dev)
CONNECTION_STRING=

# Long random string used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login lasts (e.g. 12h, 7d)
JWT_EXPIRES_IN=12h

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder for menu PDFs. Use menu-pdfs-dev locally so tests never mix with production.
CLOUDINARY_FOLDER=menu-pdfs
# Folder for profile pictures. Use admin-avatars-dev locally.
CLOUDINARY_AVATAR_FOLDER=admin-avatars
# Folder for the home page's photos (Startbild). Use hero-images-dev locally.
CLOUDINARY_HERO_FOLDER=hero-images

# Optional: add Cloudflare's traffic numbers to our own on the admin's Statistik page.
# A token with "Account Analytics: Read" and the account id (docs/GO_LIVE.md).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional: the website's hostnames (default harpaviljongen.com,www.harpaviljongen.com)
# CLOUDFLARE_SITE_HOSTS=harpaviljongen.com,www.harpaviljongen.com
# Optional: read the zone instead of the whole account (token needs "Zone · Analytics · Read")
# CLOUDFLARE_ZONE_ID=

# Optional: the newsletter signup on the website. The link of a subscription form made in
# the restaurant's Get a Newsletter account (Formulär), e.g. https://gansub.com/s/AbC123/.
# Without it the website hides its signup field. See docs/GO_LIVE.md.
GETANEWSLETTER_FORM_LINK=
