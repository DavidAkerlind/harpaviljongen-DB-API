{
	"info": {
		"name": "Harpaviljongen API",
		"description": "Requests for the features used by the new admin.\n\n1. Pick the environment \"Harpaviljongen – Local\" (or Production) top right.\n2. Fill in username and password in the environment.\n3. Run \"Auth → Login\". The token is saved automatically and used by every other request.\n\nAll GETs are public. POST/PUT/PATCH/DELETE need the token.\n\n\"7. Användare\" needs a user with the role admin.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:7000/api"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "pdfId",
			"value": ""
		},
		{
			"key": "newUsername",
			"value": ""
		},
		{
			"key": "newPassword",
			"value": ""
		},
		{
			"key": "newUserId",
			"value": ""
		},
		{
			"key": "employeeToken",
			"value": ""
		},
		{
			"key": "oldEmployeeToken",
			"value": ""
		}
	],
	"item": [
		{
			"name": "1. Auth",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "noauth"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const token = pm.response.json().data?.token;",
									"if (token) {",
									"    pm.collectionVariables.set('token', token);",
									"    console.log('Token saved to collection variable \"token\"');",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Me (check token)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"me"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));"
								]
							}
						}
					]
				},
				{
					"name": "Logout",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"logout"
							]
						},
						"auth": {
							"type": "noauth"
						}
					}
				}
			]
		},
